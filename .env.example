# Copy this file to .env.local and fill in real values.
# .env.local is gitignored. Never commit real secrets.

# OpenAI-compatible endpoint. Default: https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Server-side only. Never exposed to the browser bundle.
OPENAI_API_KEY=sk-replace-me

# Chat model (defaults to gpt-4o-mini if unset).
CHAT_MODEL=gpt-4o-mini

# Image model (defaults to gpt-image-1 if unset).
IMAGE_MODEL=gpt-image-1

# Set to 1 in local dev to bypass gpt-image-1 and serve the built-in
# test pet from /api/sprite. Leave unset / 0 in production.
# USE_TEST_PET=1
