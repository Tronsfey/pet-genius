{
  "name": "@pet-genius/server",
  "version": "0.1.0",
  "description": "Hono-based factory exposing /api/sprite and /api/action for pet-genius. Drop into any Node server.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo 'no server tests yet' && exit 0",
    "prepublishOnly": "pnpm build"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "peerDependencies": {
    "hono": "^4.0.0"
  },
  "dependencies": {
    "@pet-genius/shared": "workspace:*",
    "openai": "^4.77.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "hono": "^4.6.14",
    "tsup": "^8.3.5"
  }
}
