{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "outDir": "dist-server",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,

    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/lib/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/render",
    "src/ui",
    "src/world",
    "src/pet",
    "src/ai",
    "tests"
  ]
}
